rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPortalAccess() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'active' &&
        getUserData().get('mustChangePassword', false) == false &&
        (getUserData().get('credentialsValidAfter', 0) == 0 ||
          request.auth.token.auth_time > getUserData().credentialsValidAfter) &&
        (getUserData().get('studentIdLogin', false) == false ||
          request.auth.token.get('email', '') == getUserData().studentAuthEmail);
    }

    function isRegistrar() {
      return hasPortalAccess() && getUserData().role == 'registrar';
    }

    function isProgramChair() {
      return hasPortalAccess() && getUserData().role == 'program_chair';
    }

    function ownsProgram(programId, programCode) {
      return isProgramChair() &&
        ((getUserData().get('programId', '') != '' && programId == getUserData().programId) ||
         (getUserData().get('programCode', '') != '' && programCode == getUserData().programCode));
    }

    function isTeacher() {
      return hasPortalAccess() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return hasPortalAccess() && getUserData().role == 'student';
    }

    function isStaff() {
      return hasPortalAccess() && getUserData().role in ['registrar', 'program_chair', 'teacher'];
    }

    match /system/bootstrap {
      // Free-plan first-admin bootstrap. The client must create this marker
      // atomically with the matching Registrar profile.
      allow create: if isAuthenticated() &&
        request.resource.data.registrarUid == request.auth.uid &&
        !exists(/databases/$(database)/documents/system/bootstrap);
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      // The signed-in user can read the gate even when other portal access is blocked.
      allow get: if (isAuthenticated() && userId == request.auth.uid) || isStaff();
      allow list: if isStaff();
      allow create: if (isAuthenticated() && userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'registrar' &&
        request.resource.data.status == 'active' &&
        getAfter(/databases/$(database)/documents/system/bootstrap).data.registrarUid == request.auth.uid) ||
        (isRegistrar() && request.resource.data.uid == userId &&
         request.resource.data.role in ['registrar', 'program_chair', 'teacher'] &&
         request.resource.data.status == 'active' &&
         request.resource.data.mustChangePassword == true &&
         request.resource.data.authProvisioned == true &&
         request.resource.data.email is string);
      allow create: if isRegistrar() && request.resource.data.uid == userId &&
        request.resource.data.role == 'student' && request.resource.data.status == 'active' &&
        request.resource.data.mustChangePassword == true && request.resource.data.studentIdLogin == true;
      allow update: if isAuthenticated() && userId == request.auth.uid &&
        resource.data.status == 'active' &&
        resource.data.mustChangePassword == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']) &&
        request.resource.data.mustChangePassword == false;
      allow update: if isRegistrar() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'fullName', 'email', 'phone', 'role', 'programId',
          'programCode', 'status', 'sectionId', 'sectionName', 'updatedAt'
        ]);
      allow update, delete: if false;
    }

    // Academic Programs & Sections
    match /programs/{programId} {
      allow read: if hasPortalAccess();
      allow write: if isRegistrar();
    }
    
    match /sections/{sectionId} {
      allow read: if hasPortalAccess();
      allow write: if isRegistrar();
    }
    
    // Subjects
    match /subjects/{subjectId} {
      allow read: if hasPortalAccess();
      allow write: if isRegistrar();
    }

    match /curriculums/{curriculumId} {
      allow read: if hasPortalAccess();
      allow write: if isRegistrar();
    }
    
    // Master Class Schedules
    match /schedules/{scheduleId} {
      allow read: if hasPortalAccess();
      // Registrar can create, update, delete schedules
      allow create: if isRegistrar() || ownsProgram(request.resource.data.programId, request.resource.data.programCode);
      allow delete: if isRegistrar() || ownsProgram(resource.data.programId, resource.data.programCode);
      // Program Chair can only update enrolledStudentIds for schedules in their program
      allow update: if isRegistrar() ||
        ownsProgram(resource.data.programId, resource.data.programCode) &&
        ownsProgram(request.resource.data.programId, request.resource.data.programCode);
    }
    
    // Student Enrollment records
    match /enrollments/{enrollmentId} {
      allow read: if hasPortalAccess();
      allow create, update: if isRegistrar();
      allow delete: if isRegistrar();
    }
    
    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if hasPortalAccess();
      allow create, update: if isRegistrar() || 
        (isTeacher() && request.resource.data.takenBy == request.auth.uid);
      allow delete: if isRegistrar();
    }
    
    // Assessments & Activities
    match /assessments/{assessmentId} {
      allow read: if hasPortalAccess();
      allow create, update: if isRegistrar() || isTeacher();
      allow delete: if isRegistrar() || (isTeacher() && resource.data.createdBy == request.auth.uid);
    }
    
    // Student Submissions
    match /submissions/{submissionId} {
      allow read: if hasPortalAccess();
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isRegistrar() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isRegistrar();
    }
    
    // Grades
    match /grades/{gradeId} {
      allow read: if hasPortalAccess();
      allow write: if isRegistrar() || isTeacher();
    }

    // Student Ledgers
    match /ledgers/{ledgerId} {
      allow read: if hasPortalAccess() && (isRegistrar() || request.auth.uid == ledgerId);
      allow create: if isRegistrar() || (isStudent() && request.auth.uid == ledgerId);
      allow update, delete: if isRegistrar();
    }

    match /feeConfigurations/{configId} {
      allow read: if isRegistrar() || isStudent();
      allow write: if isRegistrar();
    }

    match /feeConfigurationHistory/{historyId} {
      allow read, create: if isRegistrar();
      allow update, delete: if false;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if hasPortalAccess();
      allow create: if isRegistrar() || isProgramChair() || isTeacher();
      allow update, delete: if hasPortalAccess() && (isRegistrar() || resource.data.authorId == request.auth.uid);
    }

    match /subjectOfferings/{offeringId} {
      allow read: if hasPortalAccess();
      allow create, update, delete: if isRegistrar() || isProgramChair();
    }

    match /registrarRequests/{requestId} {
      allow read: if isRegistrar() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isRegistrar() ||
        (isStudent() && request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'submitted');
      allow update: if isRegistrar() ||
        (isStudent() && resource.data.studentId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['details', 'updatedAt']));
      allow delete: if isRegistrar();
    }

    match /credentialRequirements/{requirementId} {
      allow read: if isRegistrar() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isRegistrar();
    }
  }
}
